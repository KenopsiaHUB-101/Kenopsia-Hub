    Service     = "kenopsiahub",
    SilentMode  = false,
    SaveKey     = true,
    SaveKeyPath = "KenopsiaHUB.txt",
    AutoKick    = false,
    KickMessage = "Invalid Key.",
    HubName     = "KenopsiaHUB",
    MaxRetries  = 3,
}

